# Import this file in the Vercel project that uses the repository root.
# Replace the four example values before importing. Use the same project URL twice.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
NEXT_PUBLIC_API_URL=/api

# Server only. Project Settings > API Keys: use a secret key or legacy service_role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_OR_LEGACY_SERVICE_ROLE_KEY
# Supabase Connect > Transaction pooler: paste its URI, encode the password, require TLS.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
MENU_BUCKET=menu-originals
